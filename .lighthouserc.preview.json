{
  "//": "Variante de .lighthouserc.json pour les previews Cloudflare Pages : pas de staticDistDir, les URLs viennent du workflow. Mêmes seuils que le check local.",
  "ci": {
    "collect": {
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
